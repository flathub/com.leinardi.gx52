{
    "id": "com.leinardi.gx52",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command": "gx52",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=all",
        "--filesystem=/run/x52d.cmd:ro",
        "--talk-name=org.kde.StatusNotifierWatcher"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin"
    },
    "modules": [
        {
            "name": "gx52",
            "buildsystem": "meson",
            "builddir": true,
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/leinardi/gx52.git",
                    "tag": "v1.1.1",
                    "commit": "1cf89c496a3ff419269a3472d53844fabd6c0111"
                },
                "cargo-sources.json",
                {
                    "type": "inline",
                    "dest": ".cargo",
                    "dest-filename": "config.toml",
                    "contents": "[source.vendored-sources]\ndirectory = \"cargo/vendor\"\n\n[source.crates-io]\nreplace-with = \"vendored-sources\"\n"
                }
            ]
        }
    ]
}
